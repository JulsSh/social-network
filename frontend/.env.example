# =============================================================================
# Пример файла переменных окружения
# =============================================================================
# 
# Скопируйте этот файл как .env.local и настройте переменные:
#   cp .env.example .env.local
#
# ВАЖНО: .env.local добавлен в .gitignore и не будет закоммичен
# =============================================================================

# API URL для бэкенда (без trailing slash)
# Для локальной разработки:
VUE_APP_API_URL=http://localhost:8765/api/v1

# Для production:
# VUE_APP_API_URL=http://89.111.155.206:8765/api/v1

# WebSocket URL для реалтайм коммуникаций
# Для локальной разработки:
VUE_APP_WS_URL=ws://localhost:8765/api/v1/streaming/ws

# Для production:
# VUE_APP_WS_URL=ws://89.111.155.206:8765/api/v1/streaming/ws

# Режим окружения (development / production)
NODE_ENV=development
